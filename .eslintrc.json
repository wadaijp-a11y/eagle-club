{
  "env": {
    "browser": true,
    "es2021": true,
    "googleappsscript/googleappsscript": true
  },
  "plugins": [
    "googleappsscript"
  ],
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12
  },
  "rules": {
    "no-unused-vars": ["warn", { "vars": "all", "args": "none" }],
    "no-undef": "error"
  }
}